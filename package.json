{
  "name": "npmx-extensions-monorepo",
  "type": "module",
  "version": "0.9.2",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "author": {
    "name": "Vida Xie",
    "email": "vida_2020@163.com",
    "url": "https://github.com/9romise"
  },
  "license": "MIT",
  "homepage": "https://docs.npmx.dev/guide/vscode-extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npmx-dev/vscode-npmx.git"
  },
  "bugs": {
    "url": "https://github.com/npmx-dev/vscode-npmx/issues"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "npm run lint:fix && npm run typecheck",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt:rust": "cargo fmt --manifest-path extensions/zed/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path extensions/zed/Cargo.toml --check",
    "typecheck": "tsc -b --noEmit",
    "release": "npx bumpp -r -a -x \"node scripts/sync-zed-version.ts\"",
    "prepare": "husky"
  },
  "nano-staged": {
    "*": "eslint --fix",
    "extensions/zed/**/*.rs": "cargo fmt --manifest-path extensions/zed/Cargo.toml --"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@types/path-browserify": "catalog:dev",
    "@vida0905/eslint-config": "catalog:dev",
    "eslint": "catalog:dev",
    "husky": "catalog:dev",
    "jest-mock-vscode": "catalog:test",
    "module-replacements": "catalog:inline",
    "msw": "catalog:test",
    "nano-staged": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "typescript7": "catalog:dev",
    "vite": "catalog:dev",
    "vite-tsconfig-paths": "catalog:test",
    "vitest": "catalog:test"
  }
}
